POSTGRES_DB=aker
POSTGRES_USER=aker
POSTGRES_PASSWORD=change_me
# 5432 is the conventional local PG and 5433 is often taken; 5434 is the default here.
POSTGRES_PORT=5434
POSTGRES_HOST=localhost
AKER_DATA_DIR=./Aker Case Study Data
AKER_LOG_LEVEL=INFO

# AI insight layer (optional -- the ETL runs fine without any of this)
# Sized for 6 GB VRAM. See PLAN.md section 6.6 before changing the model or num_ctx.
OLLAMA_HOST=http://localhost:11434
AKER_INSIGHT_MODEL=qwen3.5:4b
AKER_INSIGHT_NUM_CTX_MAP=4096
AKER_INSIGHT_NUM_CTX_REDUCE=8192
AKER_INSIGHT_JOBS=1
AKER_INSIGHT_ENABLED=true
